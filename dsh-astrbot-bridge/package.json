{
  "name": "dsh-astrbot-bridge",
  "version": "0.4.0",
  "description": "让 AstrBot 把消息交给 DSH：回环 HTTP 入口 + 会话投递 + 取本轮回复。",
  "license": "MIT",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin"
  ]
}
